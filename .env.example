# Freedom24/Tradernet API Credentials
# Copy this file to .env and fill in your credentials

# Your Freedom24 login email
TRADERNET_LOGIN=your_email@example.com

# Your Freedom24 password
TRADERNET_PASSWORD=your_password

# Data source: "api" for live data, "excel" for Excel file fallback
# If credentials are set, defaults to "api"
DATA_SOURCE=api
